# BUILDWISE 환경변수 예시
# .env 가 없어도 아래 값과 같은 기본값으로 실행됩니다.
# 값을 바꾸고 싶을 때만 이 파일을 복사해 .env 를 만드세요. .env 는 커밋되지 않습니다.

# 실행 포트 — 다른 프로그램과 겹치면 바꾸세요
WEB_PORT=5173
API_PORT=8000
DB_PORT=3307

# 개발용 DB 비밀번호 — 내 PC 의 Docker 안에서만 쓰는 값입니다
MYSQL_PASSWORD=buildwise
MYSQL_ROOT_PASSWORD=buildwise-root

# 업무팀 가짜 작업 시간(ms) — 화면에서 진행 상태가 보이도록 넣은 지연입니다
BUILDWISE_MOCK_DELAY_MS=400

# 외부 AI · 음성 API 키 — 아직 쓰지 않습니다(Mock 모드).
# 연결 작업을 할 때 여기에 이름만 추가하고, 실제 값은 각자 .env 에만 넣습니다.
# OPENAI_API_KEY=
