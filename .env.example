# 저장소 루트 .env에 복사한 뒤 로컬 MySQL 비밀번호를 입력하세요.
PARTS_MYSQL_HOST=127.0.0.1
PARTS_MYSQL_PORT=3306
PARTS_MYSQL_DATABASE=dev_database
PARTS_MYSQL_USER=root
PARTS_MYSQL_PASSWORD=''

# 선택: 프론트 개발 포트
WEB_PORT=5173

# 선택: 음성 답을 서버 음성으로 읽기. 비워 두면 브라우저 음성으로 읽습니다(기본).
# none | openai | http(직접 띄운 공개 모델 서버, POST {URL}/speech 가 audio/wav 를 돌려줌)
BUILDWISE_TTS_PROVIDER=none
# openai 일 때: OPENAI_API_KEY 를 쓰고, 모델·목소리·말투를 바꿀 수 있습니다.
BUILDWISE_TTS_MODEL=gpt-4o-mini-tts
BUILDWISE_TTS_VOICE=coral
BUILDWISE_TTS_INSTRUCTIONS=
# http 일 때: https 주소와 토큰(로컬 시험만 http://localhost)
BUILDWISE_TTS_URL=
BUILDWISE_TTS_TOKEN=
# 합성 글자 수 상한. 서버를 다시 켜도 남는 원장(SQLite)에 셉니다.
BUILDWISE_TTS_DAILY_CHARS=30000
BUILDWISE_TTS_TOTAL_CHARS=250000
BUILDWISE_TTS_USAGE_DB=
