diff --git a/backend/app/domains/hardware/ingestion/fit_specs.py b/backend/app/domains/hardware/ingestion/fit_specs.py
new file mode 100644
index 0000000..ed58259
--- /dev/null
+++ b/backend/app/domains/hardware/ingestion/fit_specs.py
@@ -0,0 +1,81 @@
+"""Apply official fit specifications to the exact docyx identities reviewed for the shop."""
+
+from app.domains.hardware.ingestion.common import DATA, json_text, read_json, read_specs
+
+
+def load_fit_reviews():
+    rows = read_json(DATA / "reviewed_fit_specs.json")
+    reviews = {r["source_key"]: r for r in rows}
+    if len(reviews) != len(rows):
+        raise ValueError("중복된 조립 사양 원본 키입니다.")
+    for row in rows:
+        urls = [row["source_url"], *row.get("field_sources", {}).values()]
+        if not all(url.startswith("https://") for url in urls):
+            raise ValueError("제조사 HTTPS 출처가 필요합니다.")
+        if set(row["specs"]).intersection(row.get("unverified", [])):
+            raise ValueError("미확인 필드를 사양으로 적재할 수 없습니다.")
+    return reviews
+
+
+def fit_updates(specs, category, model, review):
+    origin = specs["_provenance"]
+    if (
+        origin.get("source") != "docyx"
+        or origin.get("source_key") != review["source_key"]
+        or origin.get("raw_name") != review["raw_name"]
+        or category != review["category"]
+        or ("match_model" in review and review["match_model"] != model)
+    ):
+        raise ValueError(f"{review['raw_name']}: 검토 제품의 식별자가 다릅니다.")
+    updates = {}
+    for field, value in review["specs"].items():
+        if specs.get(field) is not None and specs[field] != value:
+            raise ValueError(f"{review['raw_name']}: 기존 {field} 값과 제조사 자료가 다릅니다.")
+        url = review.get("field_sources", {}).get(field, review["source_url"])
+        updates[field] = value
+        updates[field + "_source_url"] = url
+    # Missing measurements stay absent, so consumers never compare a status string as a spec.
+    status = dict(specs.get("fit_review_status", {}))
+    for field in review["specs"]:
+        status.pop(field, None)
+    for field in review.get("unverified", ()):
+        value = model if field == "model_number" else specs.get(field)
+        if value is None:
+            status[field] = "unverified"
+        else:
+            status.pop(field, None)
+    if status or "fit_review_status" in specs:
+        updates["fit_review_status"] = status
+    return {k: v for k, v in updates.items() if specs.get(k) != v}
+
+
+def refresh_fit_specs(connection, reviews, *, apply=False):
+    diff = []
+    with connection.cursor(dictionary=True) as cursor:
+        for key, review in sorted(reviews.items()):
+            cursor.execute(
+                "SELECT part_id,category,model_number,specs FROM parts WHERE category=%s "
+                "AND specs->>'$._provenance.source'='docyx' "
+                "AND specs->>'$._provenance.source_key'=%s" + (" FOR UPDATE" if apply else ""),
+                (review["category"], key),
+            )
+            hits = cursor.fetchall()
+            if len(hits) != 1:
+                raise ValueError(f"{key}: DB에서 정확히 한 제품을 식별해야 합니다.")
+            row = hits[0]
+            specs = read_specs(row["specs"])
+            changes = fit_updates(specs, row["category"], row["model_number"], review)
+            if changes:
+                diff.append(
+                    {
+                        "part_id": row["part_id"],
+                        "before": {k: specs.get(k) for k in changes},
+                        "after": changes,
+                    }
+                )
+                if apply:
+                    cursor.execute(
+                        "UPDATE parts SET specs=%s WHERE part_id=%s",
+                        (json_text(specs | changes), row["part_id"]),
+                    )
+    return diff
diff --git a/backend/app/domains/hardware/reviewed_fit.py b/backend/app/domains/hardware/reviewed_fit.py
new file mode 100644
index 0000000..07d13c6
--- /dev/null
+++ b/backend/app/domains/hardware/reviewed_fit.py
@@ -0,0 +1,80 @@
+"""Interpret field-level manufacturer evidence on a resolved selection."""
+
+from re import fullmatch
+
+
+def _native_storage(ports, drive):
+    interface = drive.get("interface") or ""
+    if fullmatch(r"SATA (1\.5|3\.0|6\.0) Gb/s", interface) and ports["sata_6g_ports"] > 0:
+        return "PASS", "드라이브와 보드 모두 SATA 데이터 포트를 사용합니다."
+    if interface.startswith("SAS ") or interface.startswith("PATA "):
+        return "FAIL", f"이 보드의 기본 SATA·M.2 포트에 {interface} 장치를 직접 연결할 수 없습니다."
+    if interface.startswith("M.2 "):
+        if interface == "M.2 SATA" and not ports["m2_sata"]:
+            return "FAIL", "이 보드의 저장장치용 M.2 슬롯은 SATA 방식을 지원하지 않습니다."
+        return "UNKNOWN", "M.2 장치의 길이·키와 슬롯의 지원 모드·공유 포트를 확인하세요."
+    return "UNKNOWN", "저장장치 연결 방식과 보드의 기본 포트를 대조할 근거가 부족합니다."
+
+
+def add_reviewed_fit(selected, checks):
+    fields = {
+        "COOLER_SOCKET": (("cpu", "socket"), ("cooler", "sockets")),
+        "COOLER_CLEARANCE": (("case", "max_cpu_cooler_mm"), ("cooler", "height_mm")),
+        "BOARD_CASE": (("case", "board_sizes"), ("motherboard", "form_factor")),
+        "PSU_CASE": (("case", "psu_sizes"), ("psu", "form_factor")),
+        "PSU_CLEARANCE": (("case", "max_psu_length_mm"), ("psu", "length_mm")),
+        "GPU_CLEARANCE": (("case", "max_gpu_length_mm"), ("gpu", "length_mm")),
+        "PSU_CAPACITY": (("gpu", "recommended_psu_w"), ("cpu", "cpu_power_limit_w")),
+        "STORAGE_INTERFACE": (("motherboard", "storage_ports"), ("storage", "drive_protocol")),
+        "GPU_POWER_CONNECTORS": (("gpu", "required_pcie_8pin"), ("psu", "pcie_8pin_available")),
+    }
+    specs = {role: row.get("specs", {}) for role, row in selected.items()}
+    limit = specs.get("case", {}).get("max_psu_length_mm")
+    if "psu" in selected and specs.get("case", {}).get("max_psu_length_mm_source_url"):
+        length = specs["psu"].get("length_mm")
+        verdict, reason = (
+            "UNKNOWN",
+            f"기본 배치의 파워 길이 한도는 {limit}mm입니다. 파워 길이를 확인하세요.",
+        )
+        if type(length) in (int, float) and length > 0:
+            verdict = "PASS" if length <= limit else "FAIL"
+            reason = f"기본 배치에서 파워 길이 {length}mm / 허용 {limit}mm"
+        checks.append({"check_type": "PSU_CLEARANCE", "result": verdict, "reason": reason})
+    required = specs.get("gpu", {}).get("required_pcie_8pin")
+    if "psu" in selected and type(required) is int and required > 0:
+        supplied = specs["psu"].get("pcie_8pin_available")
+        verdict, reason = (
+            "UNKNOWN",
+            f"GPU에 PCIe 8핀 {required}개가 필요합니다. 파워의 케이블 구성을 확인하세요.",
+        )
+        if type(supplied) is int and supplied >= 0:
+            verdict = "PASS" if supplied >= required else "FAIL"
+            reason = f"PCIe 보조전원 8핀 필요 {required}개 / 제공 {supplied}개"
+        checks.append({"check_type": "GPU_POWER_CONNECTORS", "result": verdict, "reason": reason})
+    ports = specs.get("motherboard", {}).get("storage_ports")
+    for check in checks:
+        code = check["check_type"]
+        if (
+            code == "STORAGE_INTERFACE"
+            and ports
+            and "storage" in specs
+            and check["result"] == "UNKNOWN"
+        ):
+            check["result"], check["reason"] = _native_storage(ports, specs["storage"])
+        for role, field in fields.get(code, ()):
+            row = selected.get(role)
+            url = specs.get(role, {}).get(field + "_source_url")
+            if not row or not url:
+                continue
+            sources = check.setdefault("sources", [])
+            if any(source["url"] == url for source in sources):
+                continue
+            sources.append(
+                {
+                    "chunk_key": f"DB-SPEC-{row['id']}-{field}",
+                    "title": row["name"] + " 제조사 사양",
+                    "url": url,
+                    "origin": "부품 DB의 제조사 사양",
+                    "text": f"{field} = {specs[role][field]}",
+                }
+            )
